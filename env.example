# このファイルをコピーして `.env` にリネームし、値だけ埋めてください。
# `.env` は Git にコミットされません（ルートの .gitignore）。

SOUGEI_PREP_LINE_CHANNEL_ACCESS_TOKEN=__LINE_CHANNEL_ACCESS_TOKEN__
SOUGEI_PREP_LINE_TO=__LINE_TO_GROUP_OR_USER_ID__

# 任意: 1 通目の本文（未設定時はデフォルト文言）
# SOUGEI_PREP_LINE_TEXT=送迎準備テスト

# 任意: 1 通目をファイルから読む（CI は out/main.txt を指定）
# SOUGEI_PREP_LINE_TEXT_FILE=out/main.txt

# 任意: LINE 第2通（前回のフリーメモなど・複数行可）。空なら送らない。
# GitHub Actions 本番は out/second.txt のみ（Secret 第2通は渡さない運用推奨）。ローカル緊急用のみ下を使う。
# SOUGEI_PREP_LINE_TEXT_2=【前回のフリーメモ】\n（ここに全文）

# 任意: 第2通をファイルから（改行含み可）。_2 と _2_FILE の両方があるとファイル優先（send-local が警告）。
# SOUGEI_PREP_LINE_TEXT_2_FILE=out/second.txt

# 失敗時の第二通知（Discord Incoming または Slack Incoming Webhook URL）。未設定ならスキップ。
# SOUGEI_PREP_FAILURE_WEBHOOK_URL=
# SOUGEI_PREP_FAILURE_WEBHOOK_TEXT=送迎ワークフローが失敗しました

# ローカル: build-message が読む任意 JSON（sync-state.example.json を参照）。.gitignore 済み。
# ファイルを置かず Actions のみ使う場合は Secret SOUGEI_PREP_SYNC_STATE_JSON を使う。
