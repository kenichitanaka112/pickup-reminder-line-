{
  "name": "pickup-reminder-line",
  "version": "1.0.0",
  "private": true,
  "description": "送迎準備リマインド（LINE + GitHub Actions）。コミネコ（commit-report-tool）とは独立したリポジトリ用。",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pickup:fetch-digest": "node fetch-digest.mjs",
    "pickup:build-message": "node build-message.mjs",
    "pickup:enrich-message": "node enrich-message.mjs",
    "pickup:job-summary": "node write-pickup-job-summary.mjs",
    "pickup:send-local": "node send-local.mjs",
    "test:pickup": "node --test test/list-b-core.test.mjs",
    "validate:shops": "node validate-shops.mjs"
  }
}
